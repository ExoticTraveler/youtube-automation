# Placeholders only. Copy to .env (git-ignored) and fill in locally.
OPENAI_API_KEY=your-openai-api-key
# Alternative: path to a file (mode 600) containing the key
OPENAI_API_KEY_FILE=~/YT_QUEUE/secrets/openai_api_key

# Google OAuth client (download from Google Cloud Console; keep OUT of git)
# Expected location: ~/YT_QUEUE/secrets/client_secret.json
# Tokens are generated locally as ~/YT_QUEUE/secrets/token*.pickle
